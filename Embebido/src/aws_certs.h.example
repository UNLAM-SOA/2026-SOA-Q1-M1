// =============================================================================
// aws_certs.h.example — Template de credenciales mTLS contra AWS IoT Core.
// =============================================================================
//
// COMO USARLO:
//   1) Copiar este archivo a `aws_certs.h` (el archivo real esta gitignored).
//   2) Pegar el contenido de los 3 archivos del directorio secrets/<thing>/:
//        AWS_ROOT_CA       <- AmazonRootCA1.pem
//        AWS_DEVICE_CERT   <- certificate.pem.crt
//        AWS_PRIVATE_KEY   <- private.pem.key
//   3) Ajustar AWS_IOT_ENDPOINT con el endpoint de tu cuenta (sin port).
//      Lo sacas de: aws iot describe-endpoint --endpoint-type iot:Data-ATS
//      o del archivo secrets/<thing>/config.json -> iot_endpoint.
//
// IMPORTANTE: nunca commitear el aws_certs.h real al repo, ni los .pem.
// El .gitignore ya tiene la regla; verificalo con `git status` antes de
// pushear.
//
// Cada string es un raw literal C++11 (R"EOF(...)EOF") para preservar los
// newlines del PEM exactamente como vienen.
// =============================================================================
#ifndef AWS_CERTS_H
#define AWS_CERTS_H

// Endpoint MQTT mTLS de tu cuenta AWS. Port siempre 8883 para X.509 cert auth.
static const char* AWS_IOT_ENDPOINT = "axxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com";
static const int   AWS_IOT_PORT = 8883;

// Thing name: tiene que matchear el Thing creado en AWS IoT Core. Lo usamos
// tambien como MQTT client_id (la policy de IoT Core suele restringir
// `${iot:ClientId}` para que solo el thing dueno del cert pueda conectar
// con ese client_id).
static const char* AWS_THING_NAME = "pawgate-001";

// =============================================================================
// 1) Root CA de Amazon (AmazonRootCA1.pem) — publica, todos los devices la usan.
// =============================================================================
static const char AWS_ROOT_CA[] = R"EOF(
-----BEGIN CERTIFICATE-----
... pegar aqui el contenido de secrets/<thing>/AmazonRootCA1.pem ...
-----END CERTIFICATE-----
)EOF";

// =============================================================================
// 2) Device certificate (certificate.pem.crt) — unico por device, generado por AWS.
// =============================================================================
static const char AWS_DEVICE_CERT[] = R"EOF(
-----BEGIN CERTIFICATE-----
... pegar aqui el contenido de secrets/<thing>/certificate.pem.crt ...
-----END CERTIFICATE-----
)EOF";

// =============================================================================
// 3) Private key (private.pem.key) — SECRETO. Solo este device la tiene.
// =============================================================================
static const char AWS_PRIVATE_KEY[] = R"EOF(
-----BEGIN RSA PRIVATE KEY-----
... pegar aqui el contenido de secrets/<thing>/private.pem.key ...
-----END RSA PRIVATE KEY-----
)EOF";

#endif // AWS_CERTS_H
