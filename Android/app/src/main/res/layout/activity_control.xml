<?xml version="1.0" encoding="utf-8"?>
<!--
  Control de puerta - pantalla con 7 estados visuales manejados por ControlActivity:
    IDLE, OPENING (W06a), OPEN (W06b), CLOSING, BLOCKED (W06c), CALLING (W06d), CALL_ENDING.

  Logica en ControlActivity.java -> render(ControlState).
  Vistas con id @+id/control_* son las que mutan dinamicamente.

  Topbar restructurado como LinearLayout horizontal (igual que Historial/Horarios)
  con back button a la izquierda + title centrado + spacer a la derecha para
  balancear visualmente.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_control"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="24dp"
    android:background="@color/bg_base"
    tools:context=".ControlActivity">

    <!-- TopBar: [back] [title centrado] [spacer para balancear] -->
    <LinearLayout
        android:id="@+id/control_topbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/control_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@drawable/bg_topbar_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="@string/cd_back_button">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_primary"
                android:contentDescription="@string/cd_back_button" />
        </FrameLayout>

        <TextView
            android:id="@+id/control_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:text="@string/control_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- Spacer del mismo width que el back para que el title quede visualmente centrado -->
        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/control_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/control_topbar"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Status pill (dot + texto). Background y colores cambian dinamicamente. -->
            <LinearLayout android:id="@+id/control_status_pill"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <View android:id="@+id/control_status_dot"
                    android:background="@drawable/bg_circle_muted"
                    android:layout_width="6dp"
                    android:layout_height="6dp" />

                <TextView android:id="@+id/control_status_text"
                    android:text="@string/control_status_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15" />
            </LinearLayout>

            <!-- BigBtn: background, icon e label cambian dinamicamente. -->
            <LinearLayout android:id="@+id/control_btn_open"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView android:id="@+id/control_btn_icon"
                    android:src="@drawable/ic_door_open"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:tint="@color/bg_card"
                    android:contentDescription="@string/control_btn_open" />

                <TextView android:id="@+id/control_btn_label"
                    android:layout_marginTop="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/control_btn_open"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/bg_card"
                    android:letterSpacing="0.15" />
            </LinearLayout>

            <!-- Hint: se muestra solo cuando hace falta (OPEN/BLOCKED/CALLING).
                 visibility=gone por default; ControlActivity la prende segun el estado. -->
            <TextView android:id="@+id/control_btn_hint"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:visibility="gone"
                tools:text="Cerrará automáticamente en 5s"
                tools:visibility="visible" />

            <!-- Boton secundario: "Desbloquear" o "Detener llamada". gone por default. -->
            <TextView android:id="@+id/control_btn_secondary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_button_outline_neutral"
                android:gravity="center"
                android:text="@string/control_secondary_unblock"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Row de 2 cards: Bloquear (izq) + Llamar (der) -->
            <LinearLayout android:baselineAligned="false"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout android:id="@+id/control_card_block"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:gravity="start"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="5dp">

                        <ImageView android:id="@+id/control_card_block_icon"
                            android:src="@drawable/ic_lock"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:tint="@color/text_primary"
                            android:contentDescription="@null" />

                        <View android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />

                        <!-- Arrow se oculta cuando esta BLOQUEADO -->
                        <ImageView android:id="@+id/control_card_block_arrow"
                            android:src="@drawable/ic_arrow_up_right"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:tint="@color/text_muted"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <LinearLayout android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp">

                        <TextView android:text="@string/control_card_block_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView android:id="@+id/control_card_block_subtitle"
                            android:text="@string/control_card_block_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/control_card_call"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="5dp">

                        <ImageView android:id="@+id/control_card_call_icon"
                            android:src="@drawable/ic_megaphone"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:tint="@color/text_primary"
                            android:contentDescription="@null" />

                        <View android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />

                        <!-- Arrow se oculta cuando esta BLOQUEADO -->
                        <ImageView android:id="@+id/control_card_call_arrow"
                            android:src="@drawable/ic_arrow_up_right"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:tint="@color/text_muted"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <LinearLayout android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp">

                        <TextView android:text="@string/control_card_call_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView android:id="@+id/control_card_call_subtitle"
                            android:text="@string/control_card_call_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom info strip: sensor / ultima apertura / modo seguridad / mascota notificada -->
            <LinearLayout android:id="@+id/control_info_strip"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:gravity="center_vertical">

                <FrameLayout android:id="@+id/control_info_icon_box"
                    android:background="@drawable/bg_icon_outlined"
                    android:layout_width="36dp"
                    android:layout_height="36dp">

                    <ImageView android:id="@+id/control_info_icon"
                        android:src="@drawable/ic_radio"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        app:tint="@color/text_primary"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">

                    <TextView android:id="@+id/control_info_title"
                        android:text="@string/control_sensor_title"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary" />

                    <TextView android:id="@+id/control_info_subtitle"
                        android:text="@string/control_sensor_subtitle"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include android:id="@+id/bottom_nav"
        layout="@layout/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
