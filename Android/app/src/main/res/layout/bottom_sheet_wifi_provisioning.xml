<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom sheet del flow "Cambiar red WiFi". MOCK por ahora: el ESP32 real
    no acepta provisioning OTA via MQTT (necesita BLE o AP-mode). Cuando
    cerremos Fase 14 esto va a publicar credenciales a un topic seguro tipo
    pawgate/{id}/cmd/wifi-provision y el firmware se reconectara con esas.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_base">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wifi_provisioning_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/wifi_provisioning_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- SSID input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:hint="@string/wifi_provisioning_ssid_hint"
        app:boxBackgroundMode="outline">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/wifi_prov_ssid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLength="32" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/wifi_provisioning_password_hint"
        app:boxBackgroundMode="outline"
        app:passwordToggleEnabled="true">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/wifi_prov_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:maxLength="63" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Mock notice -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:padding="10dp"
        android:background="@drawable/bg_pill_status"
        android:text="@string/wifi_provisioning_mock_notice"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- Connect button -->
    <TextView
        android:id="@+id/wifi_prov_btn_connect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/wifi_provisioning_btn_connect"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
