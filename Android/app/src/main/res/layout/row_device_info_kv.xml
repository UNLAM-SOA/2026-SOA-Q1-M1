<?xml version="1.0" encoding="utf-8"?>
<!--
    Row 'Key: Value' usado en DeviceDetailActivity. Se incluye 6 veces en el
    layout principal (uptime, temp, RAM, flash, IP, rssi). El Activity setea
    el texto por findViewById() del include id y luego buscando R.id.label /
    R.id.value adentro.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/row_kv_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:ignore="HardcodedText"
        xmlns:tools="http://schemas.android.com/tools"
        android:text="Label" />

    <TextView
        android:id="@+id/row_kv_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText"
        xmlns:tools="http://schemas.android.com/tools"
        android:text="—" />
</LinearLayout>
