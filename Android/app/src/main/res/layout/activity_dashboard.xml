<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="10dp"
    android:minHeight="10dp"
    android:paddingTop="24dp"
    android:visibility="visible"
    tools:context=".DashboardActivity">
    <ScrollView
        android:id="@+id/dashboard_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout android:background="@color/bg_base"
                android:paddingVertical="10dp"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="horizontal">
                <TextView android:text="@string/dashboard_title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:layout_width="0dp"
                    android:layout_weight="1" />
                <FrameLayout android:background="@drawable/bg_topbar_button"
                    android:contentDescription="@string/cd_notifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:id="@+id/dashboard_notification">
                    <ImageView
                        android:contentDescription="@string/cd_notifications"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/text_primary"
                        android:layout_gravity="center" />
                    <!-- Badge de notifs no leidas (Sub-fase C). DashboardActivity
                         lo refresca cuando vuelve a foreground (onResume). Si
                         count == 0 va GONE; > 9 muestra "9+". -->
                    <TextView
                        android:id="@+id/dashboard_notification_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:minWidth="16dp"
                        android:minHeight="16dp"
                        android:paddingHorizontal="4dp"
                        android:background="@drawable/bg_unread_badge"
                        android:gravity="center"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:id="@+id/dashboard_greeting"
                android:text="@string/dashboard_greeting_template"
                tools:text="Hola, Esteban"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:id="@+id/dashboard_door_card">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/dashboard_door_status"
                    android:text="@string/dashboard_door_closed"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:id="@+id/dashboard_last_activity"
                    android:text="@string/dashboard_no_recent_activity"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" >
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp" >
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_metric_openings_label"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:id="@+id/dashboard_openings_count"
                        android:text="—"
                        tools:text="24"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp" >
                    <TextView android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_metric_light_label"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                    <!-- Numero + icono de lampara al lado. ImageView se hace
                         GONE cuando no hay info aun. Tinte amarillo (encendida)
                         o gris (apagada) se aplica desde renderLightBadge(). -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/dashboard_light_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            tools:text="12h 34m" />
                        <ImageView
                            android:id="@+id/dashboard_light_badge"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="10dp"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/dashboard_light_off"
                            android:src="@drawable/ic_lamp_off"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/dashboard_quick_actions"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <LinearLayout android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" >
                    <LinearLayout android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_button_primary"
                        android:gravity="center"
                        android:padding="10dp"
                        android:id="@+id/action_open"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView app:tint="@color/bg_card"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_door_open"
                            android:contentDescription="@string/action_open" />
                        <TextView android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_open"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/bg_card" />
                    </LinearLayout>
                    <LinearLayout android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_outline_danger"
                        android:gravity="center"
                        android:padding="10dp"
                        android:id="@+id/action_block"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView android:id="@+id/action_block_icon"
                            app:tint="@color/accent_block"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_lock"
                            android:contentDescription="@string/action_block" />
                        <TextView android:id="@+id/action_block_label"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_block"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_block" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" >
                    <LinearLayout android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:gravity="center"
                        android:padding="10dp"
                        android:id="@+id/action_call"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView app:tint="@color/text_primary"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_phone_call"
                            android:contentDescription="@string/action_call" />
                        <TextView android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_call"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                    <LinearLayout android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:gravity="center"
                        android:padding="10dp"
                        android:id="@+id/action_schedules"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView app:tint="@color/text_primary"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_calendar"
                            android:contentDescription="@string/action_schedules" />
                        <TextView android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_schedules"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
    <include
        android:id="@+id/bottom_nav"
        layout="@layout/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>