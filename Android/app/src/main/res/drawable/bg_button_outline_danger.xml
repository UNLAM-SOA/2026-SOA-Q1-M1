<?xml version="1.0" encoding="utf-8"?>
<!-- Boton outlined con borde rojo. Para "Bloquear" del Dashboard quick actions:
     resalta que es una accion sensible (modo seguridad). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_card" />
    <stroke
        android:width="1.5dp"
        android:color="@color/accent_block" />
    <corners android:radius="12dp" />
</shape>
