<?xml version="1.0" encoding="utf-8"?>
<!--
  BottomNav reutilizable. Se incluye con <include layout="@layout/bottom_nav"/>
  en cada Activity que lo necesite (Dashboard, Control, Historial, Ajustes).

  Cada tab tiene un id propio para que el Activity le ponga setOnClickListener
  y lance la siguiente Activity con un Intent. El tab "activo" (el que
  corresponde a la pantalla actual) se marca cambiando manualmente el tint
  del icono y el color/peso del texto al color accent_neon.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_card">

    <!-- Divider superior 1dp para separar visualmente del contenido scrolleable -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_subtle" />

    <!-- Fila horizontal con los 4 tabs distribuidos por weight -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Tab Inicio (activo por default cuando se renderiza dentro del Dashboard) -->
        <LinearLayout
            android:id="@+id/nav_inicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_house"
                android:contentDescription="@string/dashboard_tab_inicio"
                app:tint="@color/accent_neon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dashboard_tab_inicio"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/accent_neon" />
        </LinearLayout>

        <!-- Tab Puerta -->
        <LinearLayout
            android:id="@+id/nav_puerta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_door_open"
                android:contentDescription="@string/dashboard_tab_puerta"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dashboard_tab_puerta"
                android:textSize="11sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!-- Tab Historial -->
        <LinearLayout
            android:id="@+id/nav_historial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chart_column"
                android:contentDescription="@string/dashboard_tab_historial"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dashboard_tab_historial"
                android:textSize="11sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!-- Tab Ajustes -->
        <LinearLayout
            android:id="@+id/nav_ajustes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/dashboard_tab_ajustes"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dashboard_tab_ajustes"
                android:textSize="11sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
