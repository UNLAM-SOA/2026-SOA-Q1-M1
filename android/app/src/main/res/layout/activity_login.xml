<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:paddingHorizontal="24dp"
    android:paddingTop="80dp"
    android:paddingBottom="140px"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".LoginActivity">
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_logo_primary">
        <ImageView
            android:contentDescription="@string/app_name"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_dog"
            android:layout_gravity="center"
            app:tint="@color/bg_card" />
    </FrameLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:layout_marginBottom="14dp"
        android:textStyle="bold"
        android:text="@string/login_button"/>
    <LinearLayout android:background="@drawable/bg_input"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_height="56dp"
        android:layout_marginBottom="14dp"
        android:layout_width="match_parent"
        android:orientation="horizontal">
        <ImageView android:contentDescription="@string/app_name"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_mail"
            android:layout_gravity="center"
            app:tint="@color/text_muted"/>
        <EditText android:background="@null"
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:inputType="textEmailAddress"
            android:imeOptions="actionNext"
            android:hint="@string/login_email_placeholder"
            android:id="@+id/login_email_input"/>
    </LinearLayout>

    <LinearLayout android:background="@drawable/bg_input"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_height="56dp"
        android:layout_marginBottom="14dp"
        android:layout_width="match_parent"
        android:orientation="horizontal">
        <ImageView android:contentDescription="@string/app_name"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_lock"
            android:layout_gravity="center"
            app:tint="@color/text_muted"/>
        <EditText android:background="@null"
            android:layout_height="match_parent"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:id="@+id/login_password_input"
            android:hint="@string/login_password_placeholder"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:textAlignment="textEnd"
        android:textColor="@color/text_secondary"
        android:textStyle="bold"
        android:layout_marginBottom="14dp"
        android:text="@string/login_forgot_password"/>

    <Button android:layout_height="56dp"
        android:layout_width="match_parent"
        android:id="@+id/login_submit_button"
        android:text="@string/login_button"
        android:textColor="@color/bg_card"
        android:textStyle="bold"
        android:textSize="16sp"
        app:backgroundTint="@color/accent_neon"
        app:cornerRadius="14dp"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:text="@string/login_no_account"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_signup"
            android:textSize="16sp"
            android:textColor="@color/accent_neon"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>