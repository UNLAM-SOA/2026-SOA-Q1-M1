<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_control"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="24dp"
    android:background="@color/bg_base"
    tools:context=".ControlActivity">
    <TextView
        android:id="@+id/control_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/control_title"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ScrollView android:id="@+id/control_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/control_title"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">
            <LinearLayout android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">
                <View android:background="@drawable/bg_circle_muted"
                    android:layout_width="6dp"
                    android:layout_height="6dp"/>
                <TextView android:text="@string/control_status_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.15" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:id="@+id/control_btn_open"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView android:src="@drawable/ic_door_open"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:tint="@color/bg_card"
                    android:contentDescription="@string/control_btn_open"/>
                <TextView android:layout_marginTop="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/control_btn_open"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/bg_card"
                    android:letterSpacing="0.15" />
            </LinearLayout>
            <TextView android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/control_btn_open_hint"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:gravity="center"/>
            <LinearLayout android:baselineAligned="false"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <LinearLayout android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:gravity="start"
                    android:id="@+id/control_card_block"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:contentDescription="@null"
                        android:layout_marginBottom="5dp" >
                        <ImageView android:contentDescription="@null"
                            android:src="@drawable/ic_lock"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:tint="@color/text_primary" />
                        <View android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />
                        <ImageView android:src="@drawable/ic_arrow_up_right"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:tint="@color/text_muted"
                            android:contentDescription="@null"/>
                    </LinearLayout>
                    <LinearLayout android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp">
                        <TextView android:text="@string/control_card_block_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                        <TextView android:text="@string/control_card_block_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:id="@+id/control_card_call"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="5dp"
                        android:contentDescription="@null">
                        <ImageView android:contentDescription="@null"
                            android:src="@drawable/ic_megaphone"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:tint="@color/text_primary" />
                        <View android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />
                        <ImageView android:src="@drawable/ic_arrow_up_right"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            app:tint="@color/text_muted"
                            android:contentDescription="@null"/>
                    </LinearLayout>
                    <LinearLayout android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" >
                        <TextView android:text="@string/control_card_call_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                        <TextView android:text="@string/control_card_call_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:textColor="@color/text_muted" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:baselineAligned="false"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:gravity="center_vertical">
                <FrameLayout android:background="@drawable/bg_icon_outlined"
                    android:layout_width="36dp"
                    android:layout_height="36dp">
                    <ImageView android:src="@drawable/ic_radio"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        app:tint="@color/text_primary"
                        android:contentDescription="@null"/>
                </FrameLayout>
                <LinearLayout android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView android:text="@string/control_sensor_title"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary" />
                    <TextView android:text="@string/control_sensor_subtitle"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include android:id="@+id/bottom_nav"
        layout="@layout/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>