{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowScanSchedules",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:075138626693:table/pawgate_schedules"
    },
    {
      "Sid": "AllowRunsMarker",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:075138626693:table/pawgate_schedule_runs"
    },
    {
      "Sid": "AllowIoTPublish",
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": "arn:aws:iot:us-east-1:075138626693:topic/pawgate/*/cmd/*"
    },
    {
      "Sid": "AllowCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:075138626693:*"
    }
  ]
}
