{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPutEvents",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:075138626693:table/pawgate_events"
    },
    {
      "Sid": "AllowUpdateDeviceState",
      "Effect": "Allow",
      "Action": [
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:075138626693:table/pawgate_device_state"
    },
    {
      "Sid": "AllowReadFcmEndpoints",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan",
        "dynamodb:GetItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:075138626693:table/pawgate_fcm_endpoints"
    },
    {
      "Sid": "AllowSnsPushToFcm",
      "Effect": "Allow",
      "Action": [
        "sns:Publish",
        "sns:DeleteEndpoint"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:075138626693:*"
    }
  ]
}
