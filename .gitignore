# IDEs (Android Studio / IntelliJ / Cursor / VSCode)
.idea/
**/.idea/
*.iml
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch

# Sistemas operativos
.DS_Store
Thumbs.db

# Claude Code / Cowork agent state
.claude/
**/.claude/

# Embebido (PlatformIO)
**/.pio

# Android
**/.gradle
**/build/
**/local.properties

# Backups y temporales
*.bak
*.swp

# Secrets: certificados X.509, claves privadas y configs sensibles.
# NUNCA commitear esto al repo publico. Los compas que necesiten
# correr el simulador o el firmware deben pedir los archivos por canal
# privado (Slack/Drive del equipo).
secrets/

# Firmware: certs embebidos en el .h gitignored (los .pem reales).
# El template aws_certs.h.example SI se commitea (con placeholders).
Embebido/src/aws_certs.h

# Python virtualenvs (simulator dev)
**/.venv/

# Build artefacts: Lambda zips son generados con scripts, no se commitean
Backend/lambdas/**/*.zip

# Outputs de scripts de setup (contienen ARNs/IDs especificos del entorno)
Backend/setup-*-output.json

# Firebase: google-services.json contiene el API key publico del proyecto
# Firebase. Aunque es "publico", restringimos por package name + SHA-1, asi
# que NO es secreto en sentido estricto, pero igual cada dev lo descarga
# desde su Firebase Console y no lo commitea para evitar quilombos de merge.
Android/app/google-services.json
